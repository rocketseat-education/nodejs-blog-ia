{
  "name": "rocketseat-blog-ia-nodejs",
  "version": "1.0.0",
  "scripts": {
    "build": "docker build -t rocketseat-blog-ia-nodejs:latest .",
    "start": "node src/index.js",
    "dev": "node --env-file=.env.local --watch src/index.js",
    "env:setup": "cp .env.example .env.local",
    "local:setup": "npm run env:setup && npm run infra:up && npm run migrate:up",
    "migrate:up": "node --env-file=.env.local node_modules/.bin/postgrator migrate",
    "migrate:down": "node --env-file=.env.local node_modules/.bin/postgrator migrate 0",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "node --test ./tests/unit/**/*.test.js",
    "test:integration": "node --test --env-file=.env.test tests/integration/**/*.test.js",
    "test:e2e": "node --test --env-file=.env.test tests/e2e/**/*.test.js",
    "prepare": "lefthook install"
  },
  "license": "ISC",
  "type": "module",
  "commitlint": {
    "extends": ["@commitlint/config-conventional"]
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": ["oxlint --fix", "oxfmt"]
  },
  "dependencies": {
    "@mastra/core": "^0.20.0",
    "nanoid": "^5.1.5",
    "pg": "^8.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "lefthook": "^1.12.2",
    "lint-staged": "^16.1.2",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.16.0",
    "postgrator-cli": "^9.1.0",
    "supertest": "^7.1.4"
  }
}
